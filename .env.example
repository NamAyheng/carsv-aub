# Copy to `.env` in this folder (repo root). Never commit `.env`.
# Used by `docker compose` for CarSV locally.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_COOKIE_SECURE=0
# Lax for local Compose. On Render Static Site + API, use None (and DJANGO_COOKIE_SECURE=1).
DJANGO_REFRESH_COOKIE_SAMESITE=Lax
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api,carsv-api
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- PostgreSQL (Compose service `db` / container `carsv-db`) ---
# Host port on your machine is 5433 (avoids clash with test container postgres-db:5432).
POSTGRES_DB=carsv
POSTGRES_USER=carsv
POSTGRES_PASSWORD=carsv_change_me

# --- Auth providers (same Google client / Telegram bot as live is fine) ---
# See guidelines/LOCAL_AUTH.md and guidelines/GOOGLE_OAUTH_ORIGINS.md
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Live webhook (default): https://admin.carsv.chayhour.xyz/api/telegram/webhook/
# Local connect testing needs a public HTTPS tunnel to :8000 — see LOCAL_AUTH.md

# --- Frontend URL (verification / reset email links) ---
# Local Compose: http://127.0.0.1:3000 (prefer this host in the browser too)
# Live: https://carsv.chayhour.xyz
FRONTEND_URL=http://127.0.0.1:3000

# --- Email delivery ---
# Recommended for teammates: console — OTP codes in `docker compose logs -f api`
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CarSV <noreply@carsv.local>
EMAIL_VERIFY_RESEND_COOLDOWN=60
#
# Optional local (or required on Render): Resend HTTPS API
# EMAIL_BACKEND=django_app.email_backends.ResendAPIBackend
# RESEND_API_KEY=re_xxxxxxxx
# Live / verified domain: DEFAULT_FROM_EMAIL=CarSV <noreply@carsv.chayhour.xyz>
# Sandbox only (delivers to Resend account owner): CarSV <onboarding@resend.dev>

# --- Optional Render-only (do NOT set these for local Compose) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
# After first successful /admin login, remove DJANGO_SUPERUSER_PASSWORD from Render env.
#
# One-time public catalog seed on empty Postgres (services/parts/blog only).
# Idempotent; never creates users or private uploads. Default off.
# DJANGO_SEED_DEMO=1
# After first successful seed, set to 0 or remove and redeploy.
