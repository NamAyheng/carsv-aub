# Copy to .env in this folder. Do not commit .env.
# Non-Docker local workflow defaults to SQLite (db.sqlite3) unless DATABASE_ENGINE=postgres.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_COOKIE_SECURE=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# sqlite (default) | postgres
DATABASE_ENGINE=sqlite
# When DATABASE_ENGINE=postgres (e.g. pointing at Compose DB on localhost:5433):
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=carsv
POSTGRES_USER=carsv
POSTGRES_PASSWORD=carsv_change_me

# Google Cloud console → OAuth client → Web application.
# Put the client ID here. Never put the client secret in React.
# Google Identity Services OAuth 2.0 Web client ID (also used by /api/auth/public-config/).
# Create at https://console.cloud.google.com/apis/credentials — type "Web application".
# Authorized JavaScript origins: http://localhost:3000 (and your production frontend URL).
GOOGLE_CLIENT_ID=

# BotFather → create a bot → token. Username is the bot's @name without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional shared secret for Telegram webhook header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
